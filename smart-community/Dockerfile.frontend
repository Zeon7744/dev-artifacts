# ============================================================
# Smart Community - 前端镜像 (Vite/React 构建 + Nginx 托管)
# 构建上下文：项目根目录 smart-community/
#   docker build -f Dockerfile.frontend -t smart-community-frontend .
# ============================================================

# ---------- 阶段 1：构建静态资源 ----------
FROM node:20-alpine AS builder

WORKDIR /build

# 使用 npmmirror 国内镜像加速依赖安装
RUN npm config set registry https://registry.npmmirror.com

# 先拷贝依赖清单，利用层缓存
COPY frontend/package.json frontend/package-lock.json ./
RUN npm install

# 拷贝源码并构建
COPY frontend/ ./
RUN npm run build

# ---------- 阶段 2：Nginx 托管 ----------
FROM nginx:alpine

# 自定义 nginx 配置：SPA 托管 + /api、/api/ws 反代后端
COPY nginx.conf /etc/nginx/conf.d/default.conf

# 拷贝构建产物
COPY --from=builder /build/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
